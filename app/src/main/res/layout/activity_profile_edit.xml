<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/editToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E1E1E"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121212"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Profil"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/edit_name"
                android:inputType="textPersonName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:hint="e.g. Kantor / Default"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:padding="10dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Address / Target Server"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/edit_address"
                android:inputType="textUri"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:hint="example.com:443"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:padding="10dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="UUID"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/edit_uuid"
                android:inputType="textNoSuggestions"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:hint="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:padding="10dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Path"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/edit_path"
                android:inputType="textUri"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:hint="/vless"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:padding="10dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="SNI (Server Name Indication)"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/edit_sni"
                android:inputType="textUri"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:hint="example.com"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:padding="10dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Header Host"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/edit_host"
                android:inputType="textUri"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:hint="example.com"
                android:textColorHint="#777777"
                android:textColor="#FFFFFF"
                android:backgroundTint="#333333"
                android:padding="10dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/edit_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="SIMPAN"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
